{var $pricingVariant = $design['block_variants']['pricing'] ?? 'LIST_DOTS'}

{if !empty($content['services'])}
<section class="section" id="cenik" style="background-color: var(--card-bg);">
    <div class="container">
        <h2 class="section-title">Orientační ceník</h2>
        <p class="section-subtitle">Přehledné a férové ceny bez skrytých poplatků</p>

        {if $pricingVariant === 'COMPACT_TABLE'}
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; background-color: var(--bg); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border);">
                <thead>
                    <tr style="background-color: var(--primary); color: #ffffff; text-align: left;">
                        <th style="padding: 1rem 1.25rem;">Služba</th>
                        <th style="padding: 1rem 1.25rem; text-align: right;">Cena</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $content['services'] as $item}
                    <tr style="border-bottom: 1px solid var(--border);">
                        <td style="padding: 1rem 1.25rem; font-weight: 500;">{$item['title']}</td>
                        <td style="padding: 1rem 1.25rem; text-align: right; font-weight: 700; color: var(--primary);">{$item['price_text']}</td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>

        {elseif $pricingVariant === 'CARDS_GRID'}
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            {foreach $content['services'] as $item}
            <div class="card" style="background-color: var(--bg); text-align: center; padding: 2rem 1.5rem;">
                <h4 style="font-size: 1.125rem; margin-bottom: 0.5rem;">{$item['title']}</h4>
                <p style="font-size: 1.5rem; font-weight: 800; color: var(--primary); margin: 1rem 0;">{$item['price_text']}</p>
                <a href="#poptavka" class="btn-primary" style="width: 100%; padding: 0.625rem 1rem; font-size: 0.875rem;">Mám zájem</a>
            </div>
            {/foreach}
        </div>

        {else}
        <!-- LIST_DOTS (Default) -->
        <div class="card" style="background-color: var(--bg); max-width: 680px; margin: 0 auto;">
            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                {foreach $content['services'] as $item}
                <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;">
                    <span style="font-weight: 600; font-size: 1rem;">{$item['title']}</span>
                    <div style="flex-grow: 1; border-bottom: 2px dotted var(--border); margin: 0 0.5rem;"></div>
                    <span style="font-weight: 700; font-size: 1.125rem; color: var(--primary); white-space: nowrap;">{$item['price_text']}</span>
                </div>
                {/foreach}
            </div>
        </div>
        {/if}
    </div>
</section>
{/if}

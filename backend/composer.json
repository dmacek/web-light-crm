{
    "name": "web-light-crm/backend-api",
    "description": "REST API for Web-Light-CRM multi-tenant SaaS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "nette/application": "^3.2",
        "nette/http": "^3.3",
        "nette/di": "^3.2",
        "nette/utils": "^4.0",
        "nette/neon": "^3.4",
        "nette/robot-loader": "^4.0",
        "nette/safe-stream": "^2.6",
        "doctrine/migrations": "^3.8",
        "doctrine/dbal": "^4.0",
        "symfony/console": "^7.1",
        "symfony/http-client": "^7.1",
        "firebase/php-jwt": "^6.10",
        "ramsey/uuid": "^4.7",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-nette": "^2.0",
        "rector/rector": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60",
        "phpat/phpat": "^1.0",
        "infection/infection": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix --ansi",
        "cs:check": "php-cs-fixer fix --dry-run --diff --ansi",
        "phpstan": "phpstan analyse --no-progress --ansi",
        "rector": "rector --ansi",
        "rector:check": "rector --dry-run --ansi",
        "phpat": "phpat analyse",
        "test": "pest --parallel --colors=always",
        "qa": ["@cs:check", "@phpstan", "@rector:check", "@test"],
        "migrate": "php bin/console doctrine:migrations:migrate --no-interaction"
    }
}

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=secret_postgres_password_change_me
POSTGRES_DB=app_db
DATABASE_URL=postgres://user:secret_postgres_password_change_me@postgres:5432/app_db?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# Application & Security
APP_ENV=production
APP_DEBUG=0
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_hs256

# Base Domain
APP_DOMAIN=tvojeaplikace.cz

# Wedos WAPI (pro nákup .cz domén v ročním tarifu)
WEDOS_WAPI_USER=
WEDOS_WAPI_AUTH=
WEDOS_WAPI_TEST=1
